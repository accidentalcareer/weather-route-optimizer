# Optional: copy to .env in the repository root. .env is git-ignored.
# The backend (python-dotenv) and the Vite frontend (envDir "..") both read it;
# every setting below has the same default when left out.

# --- Backend API ---
# Allowed browser origins, comma-separated (the local Vite dev server).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Host and port are uvicorn command-line options, not .env settings, e.g.
#   cd backend && uvicorn app:app --host 127.0.0.1 --port 8000

# --- Weather data (paths relative to backend/, or absolute) ---
WEATHER_RAW_DIR=data/raw
WEATHER_PROCESSED_DIR=data/processed
# Optional: pin the server to one specific hazard NetCDF (relative to
# WEATHER_PROCESSED_DIR, or absolute); GET /api/forecasts then lists only it.
# Leave empty to offer every *.hazard.nc in WEATHER_PROCESSED_DIR; route
# requests without forecast_valid_time then use the earliest valid time.
WEATHER_HAZARD_FILE=

# The forecast region and grid resolution are not configured here: they come
# from the GRIB2 subset itself (currently 5-35 N, 65-95 E at 0.25 degrees).

# --- Frontend (Vite exposes only VITE_* vars to the browser) ---
VITE_API_BASE_URL=http://localhost:8000
